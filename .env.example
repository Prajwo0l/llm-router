# Copy to .env and fill in what you have. Every key here is optional --
# a provider with no key is simply skipped by the fallback chain (see
# app/config.py and app/providers/*_provider.py's is_configured()).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- router behaviour ---
CLASSIFIER_CHECKPOINT_DIR=training/checkpoints/difficulty-classifier
CLASSIFIER_CONFIDENCE_FLOOR=0.5

# --- semantic cache ---
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.94
SEMANTIC_CACHE_MAX_ENTRIES=50000
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- rate limiting / cost tracking ---
DEFAULT_RATE_LIMIT_PER_MINUTE=60
COST_LEDGER_PATH=data/cost_ledger.sqlite3

# --- tracing (both off by default) ---
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-router

# --- server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
